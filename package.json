{
  "name": "@gerbergpt/medusa-fulfillment-4px",
  "version": "1.0.1",
  "displayName": "Medusa v2 Fulfillment 4PX Plugin",
  "description": "4PX fulfillment service for Medusa V2",
  "author": "TONYLABS <tony.wang@tonylabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonylabs/medusa-fulfillment-4px"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    ".": {
      "import": "./.medusa/server/src/index.js",
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./providers": "./.medusa/server/src/providers/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "fulfillment",
    "4px",
    "shipping"
  ],
  "scripts": {
    "dev": "medusa plugin:develop",
    "build": "medusa plugin:build",
    "push": "medusa plugin:build && yalc push"
  },
  "dependencies": {},
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.0.0",
    "@medusajs/cli": "^2.0.0",
    "@medusajs/framework": "^2.0.0",
    "@medusajs/icons": "^2.0.0",
    "@medusajs/medusa": "^2.0.0",
    "@medusajs/test-utils": "^2.0.0",
    "@medusajs/ui": "^4.0.4",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.0.0",
    "@medusajs/cli": "^2.0.0",
    "@medusajs/framework": "^2.0.0",
    "@medusajs/medusa": "^2.0.0",
    "@medusajs/test-utils": "^2.0.0",
    "@medusajs/ui": "^4.0.4",
    "@medusajs/icons": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
